<UserControl x:Class="DemoExam5.Elements.Item"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DemoExam5.Elements"
             mc:Ignorable="d">
    <Grid Background="Blue" Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <Label x:Name="lName" Content="Наимнование:" VerticalAlignment="Top"
       FontSize="16" Margin="10,0,0,0" Grid.Column="0" />

        <Label x:Name="lResponsible" Content="Ответственный:" VerticalAlignment="Top"
       FontSize="16" Margin="10,30,0,0" />

        <Label x:Name="lReceiptDate" Content="Дата поступления:" VerticalAlignment="Top"
       FontSize="16" Margin="10,60,0,0" Grid.Column="0"  />

        <Label x:Name="lDocumentCode" Content="Код документа:" VerticalAlignment="Top"
       FontSize="16" Margin="10,90,0,0" Grid.Column="0"  />

        <Label x:Name="lOrganization" Content="Организация:" VerticalAlignment="Top"
       FontSize="16" Margin="10,0,0,0" Grid.Column="1" />

        <Label x:Name="lDirection" Content="Направление:" VerticalAlignment="Top"
       FontSize="16" Margin="10,30,0,0" Grid.Column="1"  />

        <Label x:Name="lStatus" Content="Статус:" VerticalAlignment="Top"
       FontSize="16" Margin="10,60,0,0" Grid.Column="1"  />

        <Button Click="Update" Content="Изменить" Width="100" Height="30" VerticalAlignment="Top" 
                Margin="10,25,10,0" Grid.Column="2" HorizontalAlignment="Right" />
        <Button Click="Delete" Content="Удалить" Width="100" Height="30" VerticalAlignment="Top" 
                Margin="10,65,10,0" Grid.Column="2" HorizontalAlignment="Right" />
    </Grid>
</UserControl>
