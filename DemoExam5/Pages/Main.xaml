<Page x:Class="DemoExam5.Pages.Main"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Main">

    <Grid Background="White">
        <Grid Background="Yellow" VerticalAlignment="Top" Height="70" >
            <Label Content="Учет документов" FontSize="20" FontWeight="Bold"
                   VerticalContentAlignment="Center" Margin="10"/>

            <Button Click="Add" Content="Добавить" VerticalAlignment="Top"
                    HorizontalAlignment="Right" Width="100" Height="40" Margin="10"/>
        </Grid>
        <ScrollViewer Margin="0,80,0,0">
                <StackPanel x:Name="spItems"/>
            </ScrollViewer>
        
    </Grid>
</Page>
