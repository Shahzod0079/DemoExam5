<Page x:Class="DemoExam5.Pages.Add"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:DemoExam5.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Add">

    <Grid Background="White">
        <Grid Background="Yellow" VerticalAlignment="Top" Height="70" >
            <Label Content="Учет документов" FontSize="20" FontWeight="Bold"
            VerticalContentAlignment="Center" Margin="10"/>

            <Button Click="Save" Content="Сохранить" VerticalAlignment="Top"
                        HorizontalAlignment="Right"  Width="100" Height="40" Margin="10,14,10,0"/>          
            <Button Click="Back" Content="Назад" VerticalAlignment="Top"
                        HorizontalAlignment="Right" Width="100" Height="40" Margin="10,14,120,0"/>
        </Grid>

        <Grid Margin="10,90,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            <Label x:Name="lName" Content="Наименование" FontSize="16" Margin="0,0,0,10" 
                   Grid.Column="0" Grid.Row="0" />
            <TextBox x:Name="tName" Grid.Column="0" Grid.Row="1" />

            <Label x:Name="lResponsible" Content="Ответственный" FontSize="16" Margin="0,0,0,10" 
                   Grid.Column="0" Grid.Row="2" />
            <TextBox x:Name="tResponsible" Grid.Column="0" Grid.Row="3" />

            <Label x:Name="lReceiptDate" Content="Дата поступления" FontSize="16" Margin="0,0,0,10" 
                  Grid.Column="0" Grid.Row="4" />
            <DatePicker x:Name="tReceiptDate" FontSize="16" Grid.Column="0" Grid.Row="5" />

            <Label x:Name="lDocumentCode" Content="Код документа" FontSize="16" Margin="0,0,0,10" 
                  Grid.Column="0" Grid.Row="6" />
            <TextBox x:Name="tDocumentCode" Grid.Column="0" Grid.Row="7" />

            <Label x:Name="lOrganization" Content="Оганизцаия" FontSize="16" Margin="0,0,0,10" 
                 Grid.Column="2" Grid.Row="0" />
            <TextBox x:Name="tOrganization" Grid.Column="2" Grid.Row="1" />

            <Label x:Name="lDirection" Content="Направление" FontSize="16" Margin="0,0,0,10" 
                    Grid.Column="2" Grid.Row="2" />
            <ComboBox x:Name="tDirection" Grid.Column="2" Grid.Row="3" />

            <Label x:Name="lStatus" Content="Статус" FontSize="16" Margin="0,0,0,10" 
                    Grid.Column="2" Grid.Row="4" />
            <TextBox x:Name="tStatus" Grid.Column="2" Grid.Row="5" />
        </Grid>
    </Grid>
</Page>
